# =============================================================================
# Hybro local configuration (single source of truth)
# Copy to .env at the repo root:  cp .env.example .env
#
# Docker Compose loads this file for the backend. Default agents and the
# registrar receive only an allowlisted subset via Compose interpolation
# (OPENAI_*, IMAGE_*, AGENT_REGISTRAR_TOKEN) — not the full secret set.
# Compose overrides MONGODB_URL, REDIS_URL, HYBRO_FILE_DIR,
# LOCAL_AGENT_DISCOVERY_ENABLED, and frontend BACKEND_URL for container networking.
# The frontend container does NOT receive this full secret set; NEXT_PUBLIC_*
# values are passed as image build args instead.
# install.sh can write a filtered frontend/.env.local for non-Docker npm run dev.
# =============================================================================

# -----------------------------------------------------------------------------
# Shared
# -----------------------------------------------------------------------------
# OpenAI key used by every default agent and by the backend when OpenAI
# generation or the optional OpenAI embedding route is selected.
OPENAI_API_KEY=

# Shared secret for the one-shot default-agent registrar (X-Service-Token).
# Both names must match; install.sh / ensure_registrar_token.sh write both.
# Empty disables service-token auth, so registration fails with HTTP 401.
DEFAULT_AGENT_REGISTRAR_TOKEN=
AGENT_REGISTRAR_TOKEN=

# Clerk (optional). Local Docker defaults to AUTH_MODE=mock without these.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
APP_ENV=development
AUTH_MODE=mock

FRONTEND_ORIGINS=http://localhost:3000,https://hybro.ai
API_PREFIX=/api/v1

# Host / non-Docker defaults. Docker Compose overrides MONGODB_URL and REDIS_URL.
MONGODB_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=hybro
REDIS_URL=

LEAD_AI_MODEL=gpt-4o-mini
CLASSIFIER_AI_MODEL=gpt-4o-mini
SUPERVISOR_MODEL=gpt-5.4-mini
# Applied when SUPERVISOR_MODEL is an OpenAI reasoning-capable model. Fast and
# Ultimate share the model route while using different reasoning strengths.
ORCHESTRATOR_FAST_THINKING_LEVEL=low
ORCHESTRATOR_ULTIMATE_THINKING_LEVEL=high
EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek credentials do not select the backend generation provider implicitly.
# This does not change default_agents/, which continue to use OPENAI_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-v4-flash

# Backend generation is selected only by this explicit route and defaults to
# OpenAI. DeepSeek-primary deployments must set this value to deepseek; merely
# setting DEEPSEEK_API_KEY does not select DeepSeek. Gemini/Bedrock credentials
# are unsupported and fail fast instead of falling back silently.
LLM_GATEWAY_GENERATION_PROVIDER=openai
LLM_GATEWAY_MAX_ATTEMPTS=2
LLM_GATEWAY_RETRY_BACKOFF_SECONDS=0.2
LLM_GATEWAY_REQUEST_TIMEOUT_SECONDS=60.0
LLM_GATEWAY_STREAM_TIMEOUT_SECONDS=120.0
LLM_GATEWAY_SUPERVISOR_JSON_TIMEOUT_SECONDS=30.0
LLM_GATEWAY_SUPERVISOR_TEXT_TIMEOUT_SECONDS=90.0
LLM_GATEWAY_SUPERVISOR_STREAM_TIMEOUT_SECONDS=90.0
LLM_GATEWAY_DEFAULT_GENERATION_MODEL=lead_ai_model
LLM_GATEWAY_DEFAULT_EMBEDDING_MODEL=embedding_model
LLM_GATEWAY_DEFAULT_SUPERVISOR_MODEL=supervisor_model

LOG_LEVEL=INFO
LOG_FORMAT=auto

FEATURE_RUN_EVENT_SSE=1
# Poll interval shared by the mandatory canonical lifecycle workers.
ORCHESTRATOR_WORKER_INTERVAL_SECONDS=30
SUPERVISOR_MAX_STEPS=8
RUN_WATCHDOG_STALE_MINUTES=90

SUMMARY_MAX_WORDS=
AGENT_HEALTH_CHECK_INTERVAL=3600

# Local Agent Discovery (Docker backend -> host.docker.internal).
# Docker Compose enables this explicitly. Leave disabled for other deployments.
LOCAL_AGENT_DISCOVERY_ENABLED=false
LOCAL_AGENT_DISCOVERY_HOST=host.docker.internal
LOCAL_AGENT_DISCOVERY_PORT_START=1024
LOCAL_AGENT_DISCOVERY_PORT_END=65535
LOCAL_AGENT_DISCOVERY_INTERVAL_SECONDS=120
LOCAL_AGENT_DISCOVERY_CONNECT_TIMEOUT_SECONDS=0.05
LOCAL_AGENT_DISCOVERY_PROBE_TIMEOUT_SECONDS=3

# Public URL where agents send webhooks (e.g. https://api.example.com).
# Leave empty for local Docker unless you need push/webhook delivery.
WEBHOOK_BASE_URL=
# Persistent secret for HMAC token hashing (min 32 bytes). install.sh generates
# an installation-specific value automatically. For manual setup:
#   openssl rand -hex 32
WEBHOOK_SIGNING_KEY=
MAX_TASKS_PER_USER=100
MAX_TASKS_PER_ROOM=50
STALE_CHECK_MINUTES=10
TASK_EXPIRY_HOURS=4
PENDING_TASK_WARNING_HOURS=1

CS_BACKOFF_BASE=1.0
CS_BACKOFF_MAX=30.0
CS_BACKOFF_FACTOR=2.0
CS_JITTER_FRACTION=0.25

CONTEXT_MODEL_WINDOW=128000
CONTEXT_SYSTEM_PROMPT_TOKENS=2000
CONTEXT_TOOL_SCHEMA_TOKENS=3000
CONTEXT_RESPONSE_RESERVE_TOKENS=4000
CONTEXT_ROOM_PCT=0.15
CONTEXT_HISTORY_PCT=0.60
CONTEXT_TASK_PCT=0.25

COMPACTION_ENABLED=true
COMPACTION_MAX_FULL_TURNS=20
COMPACTION_MAX_TOTAL_TOKENS=80000
COMPACTION_PRESERVE_RECENT=10
COMPACTION_CONTENT_TTL_DAYS=0
COMPACTION_CONCURRENCY=5

MEMORY_SEARCH_ENABLED=true
MEMORY_SEARCH_TEMPORAL_DECAY_ENABLED=true
MEMORY_SEARCH_HALF_LIFE_DAYS=30
MEMORY_SEARCH_MAX_RESULTS=10
MEMORY_SEARCH_MAX_CANDIDATES=1000
MEMORY_SEARCH_MAX_SNIPPET_CHARS=300

# Docker Compose sets HYBRO_FILE_DIR=/var/lib/hybro/files. Leave empty for
# non-Docker (platform data directory default).
HYBRO_FILE_DIR=

A2A_INLINE_FILE_MAX_RAW_BYTES=5242880
A2A_INLINE_MESSAGE_MAX_ENCODED_BYTES=6990508

CAPABILITY_ISSUE_THRESHOLD=2

DELIVERY_STARTED_TTL_SECONDS=3600
DELIVERY_STARTED_CACHE_MAXSIZE=10000

EVENTING_REDIS_CHANNEL=internal:global
EVENTING_REDIS_DEAD_LETTER_CHANNEL=eventing:dead_letter
EVENTING_REDIS_IO_TIMEOUT_SECONDS=5.0
EVENTING_HANDLER_QUEUE_MAXSIZE=1000
EVENTING_AUXILIARY_TASK_MAXSIZE=128
EVENTING_ENQUEUE_TIMEOUT_SECONDS=1.0
EVENTING_SHUTDOWN_TIMEOUT_SECONDS=5.0
EVENTING_DEAD_LETTER_MEMORY_MAXLEN=1000

# Connection pool tuning (per-worker)
# MONGODB_MAX_POOL_SIZE=50
# MONGODB_MIN_POOL_SIZE=10
# REDIS_MAX_CONNECTIONS=50

# Multi-worker (gunicorn) requires Redis. For no-Redis single-process:
#   uvicorn main:app

# -----------------------------------------------------------------------------
# Frontend (used by filtered frontend/.env.local for npm run dev)
# NEXT_PUBLIC_* are build args for the frontend Docker image (Compose forwards
# them into `npm run build`) and are also written to frontend/.env.local for
# non-Docker `npm run dev`. Changing them requires rebuilding the frontend image.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_ENABLE_WAITLIST=true
NEXT_PUBLIC_MAX_MESSAGE_LENGTH=10000
NEXT_PUBLIC_INSPECTION_TIMEOUT_MS=300000

# E2E test auth (Clerk testing; npm run test:e2e only)
E2E_CLERK_USER_EMAIL=
E2E_CLERK_USER_PASSWORD=
E2E_TEST_ROOM_PATH=

# -----------------------------------------------------------------------------
# Default agents
# -----------------------------------------------------------------------------
# Optional: model used by the weather agent (must support tool calling).
OPENAI_MODEL=gpt-4o-mini

# Optional: model used by the image generator agent.
# gpt-image-1 may require OpenAI org verification; fall back to dall-e-3 if needed.
IMAGE_MODEL=gpt-image-1

# Optional: generated image size.
IMAGE_SIZE=1024x1024
